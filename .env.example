# --- Feature Toggles ---
ENABLE_SSO=true
ENABLE_MULTI_TENANT=true
ENABLE_SAAS_SPEND=true
ENABLE_POWERBI_EXPORT=true
ENABLE_MULTI_CURRENCY=true
ENABLE_AI_ADVISOR=true
